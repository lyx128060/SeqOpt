+/* Agent-editable comparison algorithm island.
+ *
+ * The stock implementation deliberately delegates every comparison to the
+ * frozen HMMER pipeline. Optimized implementations can add private helpers
+ * and per-worker scratch state here while retaining the public contract and
+ * exact stock fallback in p7_evo_align_stock.c.
+ */
+#include <p7_config.h>
+
+#include <stdlib.h>
+
+#include "easel.h"
+#include "hmmer.h"
+#include "p7_evo_align.h"
+
+struct p7_evo_align_s {
+  int reserved;
+};
+
+P7_EVO_ALIGN *
+p7_evo_align_Create(void)
+{
+  return calloc(1, sizeof(P7_EVO_ALIGN));
+}
+
+int
+p7_evo_align_Reuse(P7_EVO_ALIGN *state)
+{
+  (void) state;
+  return eslOK;
+}
+
+void
+p7_evo_align_Destroy(P7_EVO_ALIGN *state)
+{
+  free(state);
+}
+
+int
+p7_evo_align_Run(P7_EVO_ALIGN *state,
+                 P7_PIPELINE *pli, P7_OPROFILE *om, P7_BG *bg,
+                 const ESL_SQ *sq, const ESL_SQ *ntsq,
+                 P7_TOPHITS *hitlist)
+{
+  (void) state;
+  return p7_evo_align_stock_Run(pli, om, bg, sq, ntsq, hitlist);
+}
