+/* Agent-editable jackhmmer iteration island.
+ *
+ * The driver owns I/O, work distribution, checkpointing, and presentation.
+ * This frozen API owns only construction of the round profile and conversion
+ * of completed hits into the next-round MSA/convergence decision.
+ */
+#ifndef p7EVO_ITER_INCLUDED
+#define p7EVO_ITER_INCLUDED
+
+#include "hmmer.h"
+
+typedef struct p7_evo_iter_s P7_EVO_ITER;
+
+extern P7_EVO_ITER *p7_evo_iter_Create (void);
+extern void         p7_evo_iter_Destroy(P7_EVO_ITER *state);
+
+extern int p7_evo_iter_BeginRound(P7_EVO_ITER *state,
+                                  P7_BUILDER *bld, ESL_SQ *query, P7_BG *bg,
+                                  P7_HMM **opt_hmm, P7_TRACE **query_trace,
+                                  ESL_MSA **round_msa, P7_OPROFILE **ret_om,
+                                  int *ret_previous_msa_nseq);
+
+extern int p7_evo_iter_EndRound(P7_EVO_ITER *state,
+                                P7_TOPHITS *hits, P7_PIPELINE *pli,
+                                const ESL_ALPHABET *abc, ESL_SQ *query,
+                                P7_TRACE *query_trace, ESL_KEYHASH *ranking,
+                                int iteration, int previous_msa_nseq,
+                                ESL_MSA **ret_msa, int *ret_new_targets,
+                                int *ret_converged);
+
+/* Exact reference fallbacks. These implementations are frozen. */
+extern int p7_evo_iter_stock_BeginRound(P7_BUILDER *bld, ESL_SQ *query,
+                                        P7_BG *bg, P7_HMM **opt_hmm,
+                                        P7_TRACE **query_trace,
+                                        ESL_MSA **round_msa,
+                                        P7_OPROFILE **ret_om,
+                                        int *ret_previous_msa_nseq);
+
+extern int p7_evo_iter_stock_EndRound(P7_TOPHITS *hits, P7_PIPELINE *pli,
+                                      const ESL_ALPHABET *abc, ESL_SQ *query,
+                                      P7_TRACE *query_trace,
+                                      ESL_KEYHASH *ranking, int iteration,
+                                      int previous_msa_nseq,
+                                      ESL_MSA **ret_msa,
+                                      int *ret_new_targets,
+                                      int *ret_converged);
+
+#endif /* p7EVO_ITER_INCLUDED */
--- a/src/p7_evo_iter_stock.c
+++ b/src/p7_evo_iter_stock.c
@@ -0,0 +1,75 @@
+/* Frozen reference implementation of jackhmmer's iteration policy. */
+#include <p7_config.h>
+
+#include "easel.h"
+#include "esl_keyhash.h"
+#include "esl_msa.h"
+#include "esl_sq.h"
+
+#include "hmmer.h"
+#include "p7_evo_iter.h"
+
+int
+p7_evo_iter_stock_BeginRound(P7_BUILDER *bld, ESL_SQ *query, P7_BG *bg,
+                             P7_HMM **opt_hmm, P7_TRACE **query_trace,
+                             ESL_MSA **round_msa, P7_OPROFILE **ret_om,
+                             int *ret_previous_msa_nseq)
+{
+  int status;
+
+  if (*round_msa == NULL)
+    {
+      *ret_previous_msa_nseq = 1;
+      return p7_SingleBuilder(bld, query, bg, opt_hmm, query_trace,
+                              NULL, ret_om);
+    }
+
+  *ret_previous_msa_nseq = (*round_msa)->nseq;
+  status = p7_Builder(bld, *round_msa, bg, opt_hmm, NULL, NULL, ret_om,
+                      NULL);
+  if (status != eslOK) return status;
+
+  esl_msa_Destroy(*round_msa);
+  *round_msa = NULL;
+  return eslOK;
+}
+
+int
+p7_evo_iter_stock_EndRound(P7_TOPHITS *hits, P7_PIPELINE *pli,
+                           const ESL_ALPHABET *abc, ESL_SQ *query,
+                           P7_TRACE *query_trace, ESL_KEYHASH *ranking,
+                           int iteration, int previous_msa_nseq,
+                           ESL_MSA **ret_msa, int *ret_new_targets,
+                           int *ret_converged)
+{
+  int status;
+
+  p7_tophits_SortBySortkey(hits);
+  if ((status = p7_tophits_Threshold(hits, pli)) != eslOK) return status;
+  if ((status = p7_tophits_CompareRanking(hits, ranking,
+                                          ret_new_targets)) != eslOK)
+    return status;
+
+  status = p7_tophits_Alignment(hits, abc, &query, &query_trace, 1,
+                                p7_ALL_CONSENSUS_COLS, ret_msa);
+  if (status != eslOK) return status;
+
+  if ((status = esl_msa_Digitize(abc, *ret_msa, NULL)) != eslOK)
+    return status;
+  if ((status = esl_msa_FormatName(*ret_msa, "%s-i%d", query->name,
+                                   iteration)) != eslOK)
+    return status;
+  if (query->acc[0] != '\0' &&
+      (status = esl_msa_SetAccession(*ret_msa, query->acc, -1)) != eslOK)
+    return status;
+  if (query->desc[0] != '\0' &&
+      (status = esl_msa_SetDesc(*ret_msa, query->desc, -1)) != eslOK)
+    return status;
+  if ((status = esl_msa_FormatAuthor(*ret_msa, "jackhmmer (HMMER %s)",
+                                     HMMER_VERSION)) != eslOK)
+    return status;
+
+  *ret_converged = (*ret_new_targets == 0 &&
+                    (*ret_msa)->nseq <= previous_msa_nseq);
+  return eslOK;
+}
