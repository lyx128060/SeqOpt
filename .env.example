# SeqAlign environment template.
#
# Copy to `.env` and fill in your own values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit real credentials, and never paste a real key
# into this template, into the README, into logs, or into test files.
# Every value below is a placeholder.
#
# The engine reads these from the process environment. If you use a shell rather
# than a dotenv loader, `export` them instead (see `set -a; . ./.env; set +a`).

# ---------------------------------------------------------------------------
# LLM endpoint (only needed by the "model as proposer" path)
# ---------------------------------------------------------------------------
LLM_API_KEY=your-api-key-here
LLM_MODEL=your-openai-compatible-model
LLM_API_BASE=https://your-llm-endpoint.example/v1

# ---------------------------------------------------------------------------
# Reference data (download separately; see README "Configuration")
# ---------------------------------------------------------------------------
ASTRAL_DB=/path/to/astral-scopedom-seqres-gd-sel-gs-bib-40-2.08.fa
UNIREF_DB=/path/to/uniref90.fasta
SCOP_TXT=/path/to/dir.cla.scope.2.08-stable.txt

# ---------------------------------------------------------------------------
# Test suite: a small search database avoids fingerprinting 60.9 GB UniRef90.
# Tests that need it are skipped when it is unset or missing.
# ---------------------------------------------------------------------------
SEQALIGN_TEST_UNIREF_DB=/path/to/uniprot_sprot.fasta

# ---------------------------------------------------------------------------
# Evaluation backend
#   slurm -> submit job arrays (the configuration every reported number used)
#   local -> run HMMER on the current node (smoke testing only; NOT comparable)
# ---------------------------------------------------------------------------
SEQ_ALIGN_EVAL_BACKEND=slurm
SEQ_ALIGN_SLURM_PARTITION=your-partition

# Cores ONE query may use. Candidate and reference must agree, otherwise the
# comparability fingerprint refuses to compare the two costs.
SEQ_ALIGN_SLURM_FULL_CPUS=8

# Queries per submitted job, and in-job concurrency.
SEQ_ALIGN_SLURM_FULL_QUERIES_PER_JOB=5
SEQ_ALIGN_SLURM_FULL_MAX_PARALLEL=10

# ---------------------------------------------------------------------------
# Acceptance gate. These values decide what counts as a result.
# `min_speedup_fraction` must be justified against measured noise for YOUR
# configuration; see results/noise_floor_calibration.json.
# `paired_current_best_repeats` >= 2 makes decisions cancel timing drift.
# ---------------------------------------------------------------------------
SEQ_ALIGN_MIN_COMMIT_SPEEDUP_FRACTION=0.03
SEQ_ALIGN_EVAL_REPEATS=2
SEQ_ALIGN_PAIRED_CURRENT_BEST_REPEATS=2
